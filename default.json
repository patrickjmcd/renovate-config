{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for patrickjmcd's repos. Use with: { \"extends\": [\"local>patrickjmcd/renovate-config\"] }",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Chicago",
  "prHourlyLimit": 0,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "One weekly PR for all non-major npm updates, so they stop conflicting in the lockfile",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-non-major",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "One weekly PR for all non-major Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Go non-major dependencies",
      "groupSlug": "go-non-major",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "One weekly PR for all non-major Python updates",
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "poetry"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python non-major dependencies",
      "groupSlug": "python-non-major",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "One PR for non-major Docker base image updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Docker images",
      "groupSlug": "docker-images"
    },
    {
      "description": "One PR for non-major GitHub Actions updates, merged automatically once CI passes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true
    },
    {
      "description": "One PR for all major GitHub Actions updates (mostly Node runtime bumps), instead of one per action",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions-major"
    },
    {
      "description": "Node.js and pnpm versions (.nvmrc, engines, packageManager, Docker node images, @types/node) in one PR",
      "matchPackageNames": [
        "/(?:^|/)node$/",
        "@types/node",
        "pnpm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Node.js and pnpm",
      "groupSlug": "node-toolchain"
    },
    {
      "description": "Major Node.js and pnpm versions in one PR",
      "matchPackageNames": [
        "/(?:^|/)node$/",
        "@types/node",
        "pnpm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Node.js and pnpm",
      "groupSlug": "node-toolchain-major"
    },
    {
      "description": "TypeScript 7 (the native port) changed the compiler API that Next.js, SvelteKit and other tools load it through, so majors break builds until they catch up. Listed on the Dependency Dashboard for manual approval instead of opening PRs.",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
